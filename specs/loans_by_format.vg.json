{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART: 'Physical holds steady, digital keeps growing' (Section 4, top card). Stacked area chart of items borrowed per year in millions: physical (terracotta) under digital (teal), so the top edge is total borrowing.",
  "title": {
    "text": "Physical holds steady, digital keeps growing",
    "subtitle": "Items borrowed per year, millions — all growth since 2018–19 is digital"
  },
  "width": 650,
  "height": 300,
  "data": {
    "url": "data/loans_by_format.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0
      },
      "axis": {
        "labelAngle": 0
      }
    }
  },
  "layer": [
    {
      "description": "LAYER 1 - THE STACKED AREAS.",
      "mark": {
        "type": "area",
        "opacity": 0.92
      },
      "encoding": {
        "y": {
          "field": "loans_millions",
          "type": "quantitative",
          "stack": true,
          "title": null,
          "scale": {
            "domain": [
              0,
              190
            ]
          },
          "axis": {
            "tickCount": 5
          }
        },
        "color": {
          "field": "format",
          "type": "nominal",
          "scale": {
            "domain": [
              "Physical items",
              "Digital"
            ],
            "range": [
              "#c0532b",
              "#13827f"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "format",
          "sort": "descending"
        }
      }
    },
    {
      "description": "LAYER 2 - 'PHYSICAL' AND 'DIGITAL' LABELS written inside the areas.",
      "data": {
        "values": [
          {
            "year": "2021-22",
            "y": 50,
            "t": "PHYSICAL"
          },
          {
            "year": "2021-22",
            "y": 124,
            "t": "DIGITAL"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "white",
        "letterSpacing": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "LAYER 3 - END LABELS '2024-25: 61m digital' and '2024-25: 119m physical'.",
      "data": {
        "values": [
          {
            "year": "2024-25",
            "y": 150,
            "t": "2024–25: 61m digital"
          },
          {
            "year": "2024-25",
            "y": 60,
            "t": "2024–25: 119m physical"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "LAYER 4 - HOVER LINE + TOOLTIP. The 'hov' param picks the nearest year; the transforms reshape the data to one row per year (pivot) and calculate the total and digital share for the tooltip.",
      "transform": [
        {
          "pivot": "format",
          "value": "loans_millions",
          "groupby": [
            "year"
          ]
        },
        {
          "calculate": "datum['Physical items']+datum.Digital",
          "as": "Total"
        },
        {
          "calculate": "round(100*datum.Digital/datum.Total)",
          "as": "share"
        }
      ],
      "params": [
        {
          "name": "hov",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#2d2a26",
        "strokeWidth": 1
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": 0.6
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "Physical items",
            "title": "Physical (millions)"
          },
          {
            "field": "Digital",
            "title": "Digital (millions)"
          },
          {
            "field": "share",
            "title": "Digital share (%)"
          }
        ]
      }
    }
  ]
}