{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Real funding per person has fallen 13% in five years",
    "subtitle": "Spending on public libraries per Australian"
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/spending_per_person.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "dollars",
      "type": "quantitative",
      "title": "Dollars per person",
      "scale": {
        "domain": [
          40,
          62
        ]
      },
      "axis": {
        "format": "$.0f"
      }
    },
    "color": {
      "field": "basis",
      "type": "nominal",
      "scale": {
        "range": [
          "#b5532d",
          "#9a948a"
        ]
      },
      "legend": {
        "orient": "top",
        "title": null,
        "labelLimit": 320
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": true
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "dollars",
          "format": "$.2f"
        }
      }
    }
  ]
}