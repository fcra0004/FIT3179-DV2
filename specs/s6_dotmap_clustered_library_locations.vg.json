{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "CHART: 'Every public library branch in Australia' (Section 6, the last chart). Written in Vega (not Vega-Lite) because the zoom and pan need signals that drive the map projection. How the dots are made (data 'libs'): load every library, project each to screen x/y, spread out libraries at exactly the same spot, snap each to a grid of 'cell' pixels, and count the libraries in each grid square (aggregate). The grid is redone whenever you zoom, so groups split as you zoom in.",
  "width": 725,
  "height": 520,
  "padding": 0,
  "autosize": "none",
  "signals": [
    {
      "description": "Map size at zoom 1: how big Australia is drawn before zooming.",
      "name": "baseScale",
      "update": "min(width*1.28, height*1.44)"
    },
    {
      "description": "Cluster grid size in pixels. Libraries closer than this on screen are grouped. Set to 0 (no grouping) once zoomed in past x30.",
      "name": "cell",
      "update": "view.z >= 30 ? 0 : 30"
    },
    {
      "description": "The 'Jump to' drop-down above the map (cities).",
      "name": "jump",
      "value": "All of Australia",
      "bind": {
        "input": "select",
        "name": "Jump to: ",
        "options": [
          "All of Australia",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Hobart",
          "Darwin",
          "Canberra"
        ]
      }
    },
    {
      "description": "Longitude, latitude and zoom for the city picked in 'Jump to'.",
      "name": "focus",
      "value": [
        0,
        0,
        1
      ],
      "on": [
        {
          "events": {
            "signal": "jump"
          },
          "update": "jump=='Sydney' ? [0.24256,0.11437,14] : jump=='Melbourne' ? [0.14971,0.17269,14] : jump=='Brisbane' ? [0.28936,0.00842,12] : jump=='Perth' ? [-0.26625,0.07554,12] : jump=='Adelaide' ? [0.06382,0.11523,14] : jump=='Hobart' ? [0.17107,0.2622,16] : jump=='Darwin' ? [-0.04939,-0.28107,16] : jump=='Canberra' ? [0.21211,0.13535,20] : [0,0,1]"
        }
      ]
    },
    {
      "description": "Current zoom and pan: z = zoom level, tx/ty = where the map's centre sits on screen. Changed by scrolling, dragging, double-clicking, 'Jump to' and the +/- buttons (js/embed.js).",
      "name": "view",
      "init": "{z:1, tx: width/2, ty: height/2}",
      "on": [
        {
          "events": {
            "signal": "focus"
          },
          "update": "{z: focus[2], tx: width/2 - baseScale*focus[2]*focus[0], ty: height/2 - baseScale*focus[2]*focus[1]}"
        },
        {
          "events": {
            "type": "wheel",
            "consume": true
          },
          "update": "{z: clamp(view.z*pow(1.0012,-event.deltaY*pow(16,event.deltaMode)),1,300), tx: x() - (x()-view.tx)*clamp(view.z*pow(1.0012,-event.deltaY*pow(16,event.deltaMode)),1,300)/view.z, ty: y() - (y()-view.ty)*clamp(view.z*pow(1.0012,-event.deltaY*pow(16,event.deltaMode)),1,300)/view.z}"
        },
        {
          "events": "[mousedown, window:mouseup] > window:mousemove",
          "update": "{z: view.z, tx: down[2] + x() - down[0], ty: down[3] + y() - down[1]}"
        },
        {
          "events": "dblclick",
          "update": "{z:1, tx: width/2, ty: height/2}"
        }
      ]
    },
    {
      "description": "Remembers where a drag started so the map can follow the pointer.",
      "name": "down",
      "value": [
        0,
        0,
        0,
        0
      ],
      "on": [
        {
          "events": "mousedown",
          "update": "[x(), y(), view.tx, view.ty]"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "proj",
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -132,
        0
      ],
      "center": [
        2,
        -28.5
      ],
      "scale": {
        "signal": "baseScale*view.z"
      },
      "translate": [
        {
          "signal": "view.tx"
        },
        {
          "signal": "view.ty"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "data/aus_states_hi.topojson",
      "format": {
        "type": "topojson",
        "feature": "states"
      }
    },
    {
      "name": "libs",
      "url": "data/australian_public_libraries.csv",
      "format": {
        "type": "csv",
        "parse": {
          "latitude": "number",
          "longitude": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.level == 'branch' && datum.longitude > 112"
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rid"
          ]
        },
        {
          "type": "window",
          "groupby": [
            "longitude",
            "latitude"
          ],
          "ops": [
            "row_number",
            "count"
          ],
          "as": [
            "dup",
            "dupn"
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "type": "geopoint",
          "projection": "proj",
          "fields": [
            "longitude",
            "latitude"
          ],
          "as": [
            "px0",
            "py0"
          ]
        },
        {
          "type": "formula",
          "expr": "cell == 0 && datum.dupn > 1 ? datum.px0 + 11*cos(2*PI*datum.dup/datum.dupn) : datum.px0",
          "as": "px"
        },
        {
          "type": "formula",
          "expr": "cell == 0 && datum.dupn > 1 ? datum.py0 + 11*sin(2*PI*datum.dup/datum.dupn) : datum.py0",
          "as": "py"
        },
        {
          "type": "filter",
          "expr": "datum.px > -40 && datum.px < width + 40 && datum.py > -40 && datum.py < height + 40"
        },
        {
          "type": "formula",
          "expr": "cell > 0 ? floor(datum.px / cell) : datum.rid",
          "as": "gx"
        },
        {
          "type": "formula",
          "expr": "cell > 0 ? floor(datum.py / cell) : 0",
          "as": "gy"
        },
        {
          "type": "aggregate",
          "groupby": [
            "gx",
            "gy"
          ],
          "fields": [
            "px",
            "py",
            "name",
            "suburb",
            "state",
            "name"
          ],
          "ops": [
            "mean",
            "mean",
            "count",
            "min",
            "min",
            "min"
          ],
          "as": [
            "cx",
            "cy",
            "n",
            "suburb",
            "state",
            "name"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "size",
      "type": "sqrt",
      "domain": [
        1,
        250
      ],
      "range": [
        40,
        2300
      ],
      "zero": false
    }
  ],
  "marks": [
    {
      "description": "MARK 1 - STATE SHAPES (beige land with white borders).",
      "type": "shape",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#e9e2d4"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "proj"
        }
      ]
    },
    {
      "description": "MARK 2 - THE DOTS. Orange = one library, dark circle = a group (size = how many). Named 'clusters'.",
      "type": "symbol",
      "name": "clusters",
      "from": {
        "data": "libs"
      },
      "encode": {
        "update": {
          "x": {
            "field": "cx"
          },
          "y": {
            "field": "cy"
          },
          "size": {
            "scale": "size",
            "field": "n"
          },
          "fill": [
            {
              "test": "datum.n > 1",
              "value": "#2d2a26"
            },
            {
              "value": "#c0532b"
            }
          ],
          "fillOpacity": {
            "value": 0.88
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "datum.n > 1 ? {'Libraries here': datum.n, 'Tip': 'Scroll to zoom in, or choose a city from the drop-down'} : {'Library': datum.name, 'Suburb': datum.suburb, 'State': datum.state}"
          }
        }
      }
    },
    {
      "description": "MARK 3 - THE NUMBER ON EACH GROUP CIRCLE.",
      "type": "text",
      "from": {
        "data": "clusters"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "signal": "datum.datum.n > 1 ? datum.datum.n : ''"
          },
          "fill": {
            "value": "white"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "datum.datum.n > 99 ? 12 : 11"
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      }
    },
    {
      "description": "LEGEND - orange dot for 'One library'.",
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 14
          },
          "y": {
            "signal": "height-16"
          },
          "size": {
            "value": 70
          },
          "fill": {
            "value": "#c0532b"
          },
          "stroke": {
            "value": "white"
          }
        }
      }
    },
    {
      "description": "LEGEND - text 'One library'.",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 24
          },
          "y": {
            "signal": "height-12"
          },
          "text": {
            "value": "One library"
          },
          "fill": {
            "value": "#2d2a26"
          },
          "fontSize": {
            "value": 13
          }
        }
      }
    },
    {
      "description": "LEGEND - dark circle for a group.",
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 120
          },
          "y": {
            "signal": "height-16"
          },
          "size": {
            "value": 260
          },
          "fill": {
            "value": "#2d2a26"
          },
          "stroke": {
            "value": "white"
          }
        }
      }
    },
    {
      "description": "LEGEND - the '5' inside the legend's group circle.",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 120
          },
          "y": {
            "signal": "height-16"
          },
          "text": {
            "value": "5"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "description": "LEGEND - text 'Group of nearby libraries (number = how many)'.",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 134
          },
          "y": {
            "signal": "height-12"
          },
          "text": {
            "value": "Group of nearby libraries (number = how many)"
          },
          "fill": {
            "value": "#2d2a26"
          },
          "fontSize": {
            "value": 13
          }
        }
      }
    },
    {
      "description": "ZOOM READOUT - 'Zoom x1.0' at the bottom right.",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width-10"
          },
          "y": {
            "signal": "height-12"
          },
          "align": {
            "value": "right"
          },
          "text": {
            "signal": "'Zoom ×' + format(view.z,'.1f')"
          },
          "fill": {
            "value": "#8a8378"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    }
  ]
}