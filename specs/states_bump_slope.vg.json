{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART PAIR: 'Rankings barely moved' (bump chart, left) + 'A decade later' (slope chart, right). Section 3, second card. The 'hover' param below is shared by both charts: hovering a state's line in either chart fades every other state (see 'opacity' in each chart).",
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      },
      "views": [
        "bumpLines",
        "slopeLines"
      ]
    }
  ],
  "hconcat": [
    {
      "description": "LEFT CHART - BUMP CHART: each state's rank by items borrowed per person, 2010-11 to 2015-16. The 'window' transform calculates the rank (1 = most) within each year. CHANNELS: x position = year (ordinal); y position = rank (ordinal); colour = state (nominal); opacity changes when selected in hover.",
      "name": "bump",
      "width": 330,
      "height": 280,
      "title": {
        "text": "Rankings barely moved",
        "subtitle": "Rank by items borrowed per person (1 = most)"
      },
      "data": {
        "url": "data/state_loans_per_person_2010_2016.csv",
        "format": {
          "parse": {
            "loans_per_person": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "groupby": [
            "year"
          ],
          "sort": [
            {
              "field": "loans_per_person",
              "order": "descending"
            }
          ]
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "slice(datum.label,2,4)+'–'+slice(datum.label,5,7)"
          }
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelExpr": "'#'+datum.label"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "ACT",
              "NSW",
              "NT",
              "QLD",
              "SA",
              "TAS",
              "VIC",
              "WA"
            ],
            "range": [
              "#5b7fb3",
              "#d1495b",
              "#66a5ad",
              "#e8a33d",
              "#3f7d4e",
              "#9c6ba8",
              "#c9b03a",
              "#8d6a4f"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      },
      "layer": [
        {
          "description": "BUMP LAYER 1 - THE RANK LINES (one per state). Named 'bumpLines' so the hover param can listen to it.",
          "name": "bumpLines",
          "mark": {
            "type": "line",
            "strokeWidth": 3,
            "interpolate": "monotone"
          }
        },
        {
          "description": "BUMP LAYER 2 - DOTS on each year + tooltip.",
          "name": "bumpDots",
          "mark": {
            "type": "circle",
            "size": 90
          },
          "encoding": {
            "tooltip": [
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "loans_per_person",
                "title": "Items per person"
              },
              {
                "field": "rank",
                "title": "Rank"
              }
            ]
          }
        },
        {
          "description": "BUMP LAYER 3 - STATE NAMES at the right end (2015-16). CHANNELS: text = state.",
          "transform": [
            {
              "filter": "datum.year=='2015-16'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "fontWeight": "bold",
            "fontSize": 12
          },
          "encoding": {
            "text": {
              "field": "state"
            }
          }
        }
      ]
    },
    {
      "description": "RIGHT CHART - SLOPE CHART: items borrowed per person in 2014-15 vs 2024-25 for each state. CHANNELS: x position = year (ordinal); colour = state (nominal); opacity changes when selected in hover.",
      "name": "slope",
      "width": 160,
      "height": 280,
      "title": {
        "text": "A decade later",
        "subtitle": "Items per person"
      },
      "data": {
        "url": "data/state_loans_slope.csv",
        "format": {
          "parse": {
            "loans_per_person": "number",
            "label_y": "number"
          }
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelExpr": "slice(datum.label,2,4)+'–'+slice(datum.label,5,7)"
          },
          "scale": {
            "padding": 0.25
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "ACT",
              "NSW",
              "NT",
              "QLD",
              "SA",
              "TAS",
              "VIC",
              "WA"
            ],
            "range": [
              "#5b7fb3",
              "#d1495b",
              "#66a5ad",
              "#e8a33d",
              "#3f7d4e",
              "#9c6ba8",
              "#c9b03a",
              "#8d6a4f"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      },
      "layer": [
        {
          "description": "SLOPE LAYER 1 - THE SLOPE LINES (one per state). Named 'slopeLines' so the hover param can listen to it. CHANNELS: y position = loans_per_person (quantitative); one line per = state.",
          "name": "slopeLines",
          "mark": {
            "type": "line",
            "strokeWidth": 3
          },
          "encoding": {
            "y": {
              "field": "loans_per_person",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  2,
                  9.5
                ]
              },
              "axis": {
                "tickCount": 6,
                "grid": true,
                "domain": false,
                "ticks": false
              }
            },
            "detail": {
              "field": "state"
            }
          }
        },
        {
          "description": "SLOPE LAYER 2 - DOTS at each end + tooltip. CHANNELS: y position = loans_per_person (quantitative).",
          "name": "slopeDots",
          "mark": {
            "type": "circle",
            "size": 70
          },
          "encoding": {
            "y": {
              "field": "loans_per_person",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "loans_per_person",
                "title": "Items per person"
              }
            ]
          }
        },
        {
          "description": "SLOPE LAYER 3 - LABELS at the right end, e.g. 'SA 9.0'. label_y in the CSV nudges labels apart so they don't overlap. CHANNELS: y position = label_y (quantitative); text = lab.",
          "transform": [
            {
              "filter": "datum.year=='2024-25'"
            },
            {
              "calculate": "datum.state+' '+format(datum.loans_per_person,'.1f')",
              "as": "lab"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontSize": 12
          },
          "encoding": {
            "y": {
              "field": "label_y",
              "type": "quantitative"
            },
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    }
  ],
  "spacing": 36
}