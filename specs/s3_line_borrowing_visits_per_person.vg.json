{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART: 'Borrowing slid for a decade, then recovered' (Section 3, top card). Two lines: items borrowed per person (navy) and library visits per person (amber), 2010-11 to 2024-25. The shared encoding below (x = year, y = value, colour = measure) is used by every layer unless a layer sets its own. CHANNELS: x position = year (ordinal); y position = value (quantitative); colour = measure (nominal).",
  "title": {
    "text": "Borrowing slid for a decade, then recovered — visits have not",
    "subtitle": [
      "Items borrowed and library visits per Australian, per year"
    ]
  },
  "width": 650,
  "height": 300,
  "data": {
    "url": "data/national_per_person.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": -40,
        "labelPadding": 4
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          9
        ]
      },
      "axis": {
        "tickCount": 5
      }
    },
    "color": {
      "field": "measure",
      "type": "nominal",
      "scale": {
        "domain": [
          "Items borrowed per person",
          "Library visits per person"
        ],
        "range": [
          "#24426b",
          "#d4901c"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "description": "LAYER 1 - GREY 'LOCKDOWNS' SHADING BAND from 2019-20 to 2022-23. Change \"a\"/\"b\" to move its ends. CHANNELS: x position = a (ordinal); x end = b.",
      "data": {
        "values": [
          {
            "a": "2019-20",
            "b": "2022-23"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#efe8db",
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "ordinal",
          "bandPosition": 0.5
        },
        "x2": {
          "field": "b",
          "bandPosition": 0.5
        },
        "y": null,
        "color": null
      }
    },
    {
      "description": "LAYER 2 - THE WORD 'Lockdowns' at the top of the band. CHANNELS: x position = a (ordinal); text = t.",
      "data": {
        "values": [
          {
            "a": "2020-21",
            "t": "Lockdowns"
          }
        ]
      },
      "mark": {
        "type": "text",
        "y": 8,
        "dx": 23,
        "color": "#8a8378",
        "fontSize": 12,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "ordinal"
        },
        "y": null,
        "text": {
          "field": "t"
        },
        "color": null
      }
    },
    {
      "description": "LAYER 3 - THE TWO LINES.",
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "description": "LAYER 4 - DOTS ON EACH YEAR + the hover tooltip.",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45
      },
      "encoding": {
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "measure",
            "title": "Measure"
          },
          {
            "field": "value",
            "title": "Per person"
          }
        ]
      }
    },
    {
      "description": "LAYER 5 - START AND END VALUES (8.1, 4.9, 6.6, 3.3) above the first and last dots. CHANNELS: text = value.",
      "transform": [
        {
          "filter": "datum.year=='2010-11' || datum.year=='2024-25'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "value",
          "format": ".1f"
        }
      }
    },
    {
      "description": "LAYER 6 - LINE NAMES ('Items borrowed per person', 'Library visits per person') written next to the lines instead of a legend. CHANNELS: text = measure.",
      "transform": [
        {
          "filter": "datum.year=='2013-14'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 13,
        "fontWeight": "bold",
        "align": "left"
      },
      "encoding": {
        "text": {
          "field": "measure"
        }
      }
    }
  ]
}