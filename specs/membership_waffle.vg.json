{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Fewer Australians hold a library card",
    "subtitle": [
      "Each square is 1% of the population;",
      "filled squares are registered library members"
    ]
  },
  "data": {
    "url": "data/waffle_members.csv",
    "format": {
      "parse": {
        "members_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(0,100)",
      "as": "cells"
    },
    {
      "flatten": [
        "cells"
      ]
    },
    {
      "calculate": "datum.cells % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.cells/10)",
      "as": "row"
    },
    {
      "calculate": "datum.cells < round(datum.members_pct) ? 'Member' : 'Not a member'",
      "as": "status"
    }
  ],
  "facet": {
    "column": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": 150,
    "height": 150,
    "mark": {
      "type": "square",
      "size": 130
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "sort": "descending"
      },
      "color": {
        "field": "status",
        "type": "nominal",
        "scale": {
          "domain": [
            "Member",
            "Not a member"
          ],
          "range": [
            "#b5532d",
            "#e3ddd2"
          ]
        },
        "legend": {
          "orient": "bottom",
          "title": null
        }
      },
      "tooltip": [
        {
          "field": "year"
        },
        {
          "field": "members_pct",
          "title": "Members (% of population)"
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}