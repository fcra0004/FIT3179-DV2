{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australians walk through library doors",
    "subtitle": "Circle area shows in-person visits, 2024-25"
  },
  "width": "container",
  "height": 380,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28.5
    ],
    "scale": 560
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece7de",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/state_2024_25.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#b5532d",
        "opacity": 0.75,
        "stroke": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "onsite_visits_millions",
          "type": "quantitative",
          "title": "Visits (millions)",
          "scale": {
            "range": [
              30,
              2600
            ]
          },
          "legend": {
            "orient": "bottom-left"
          }
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "onsite_visits_millions",
            "title": "In-person visits (millions)"
          },
          {
            "field": "visits_per_person",
            "title": "Visits per person"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_2024_25.csv"
      },
      "mark": {
        "type": "text",
        "dy": 0,
        "fontWeight": "bold",
        "color": "#3b3a36"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        }
      }
    }
  ]
}