// COMMENTED COPY of specs/s4_marimekko_state_loans_by_format.vg.json, for reading only. The page loads specs/s4_marimekko_state_loans_by_format.vg.json.
// JSON files can't contain comments, so the comments live in this copy instead.

{  // the whole chart
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // which version of Vega-Lite / Vega this file is written for
  "description": "CHART: 'Items borrowed by state and format (2024-25)' (Section 4, second card). Marimekko (mosaic) chart for 2024-25: each column is a state, its WIDTH = that state's share of all loans in Australia, and it is split into physical (terracotta) and digital (teal) by HEIGHT. TRANSFORMS: keep 2024-25 (idx 10); add up all states ('grand'); a running total in size order gives each column's left (x0) and right (x1) edge and its rank; the three smallest states (TAS, ACT, NT, rank 6-8) are marked 'small' so they get no labels (their columns are too thin - hover shows their figures); 'fold' makes a physical and a digital row per state; y0/y1 are each block's bottom and top; 'pct' is each block's share as a percentage.",  // plain-English note about this block (does not change the chart)
  "title": "Items borrowed by state and format (2024–25)",  // title shown: Items borrowed by state and format (2024–25)
  "width": 630,  // width in pixels
  "height": 290,  // height in pixels
  "data": {  // DATA: where this chart's rows come from
    "url": "data/state_year.csv",  // load the file data/state_year.csv
    "format": {  // how to read the file
      "parse": {  // treat these columns as numbers, not text
        "physical": "number",  // read the 'physical' column as a number
        "digital": "number",  // read the 'digital' column as a number
        "total": "number",  // read the 'total' column as a number
        "idx": "number"  // read the 'idx' column as a number
      }
    }
  },
  "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
    {  // transform step 1
      "filter": "datum.idx == 10"  // keep only rows where this is true
    },
    {  // transform step 2
      "joinaggregate": [  // add a total to every row without merging rows
        {  // the calculation to do
          "op": "sum",  // operation: sum
          "field": "total",  // uses the 'total' column
          "as": "grand"  // name of the new column: grand
        }
      ]
    },
    {  // transform step 3
      "window": [  // calculate across neighbouring rows (e.g. rank)
        {  // the calculation to do
          "op": "sum",  // operation: sum
          "field": "total",  // uses the 'total' column
          "as": "cum"  // name of the new column: cum
        },
        {  // the calculation to do
          "op": "row_number",  // operation: row_number
          "as": "rank"  // name of the new column: rank
        }
      ],
      "sort": [  // order of the items
        {  // sort rule
          "field": "total",  // uses the 'total' column
          "order": "descending"  // sort descending (highest first)
        }
      ],
      "frame": [null, 0]  // use every row in the group
    },
    {  // transform step 4
      "calculate": "(datum.cum - datum.total)/datum.grand",  // new column calculated with this formula
      "as": "x0"  // name of the new column: x0
    },
    {  // transform step 5
      "calculate": "datum.cum/datum.grand",  // new column calculated with this formula
      "as": "x1"  // name of the new column: x1
    },
    {  // transform step 6
      "calculate": "datum.physical/datum.total",  // new column calculated with this formula
      "as": "phys_share"  // name of the new column: phys_share
    },
    {  // transform step 7
      "calculate": "datum.rank >= 6",  // new column calculated with this formula
      "as": "small"  // name of the new column: small
    },
    {  // transform step 8
      "fold": ["physical", "digital"],  // turn these columns into rows so they can be stacked
      "as": ["format", "millions"]  // name of the new column: ['format', 'millions']
    },
    {  // transform step 9
      "calculate": "datum.format=='physical' ? 0 : datum.phys_share",  // new column calculated with this formula
      "as": "y0"  // name of the new column: y0
    },
    {  // transform step 10
      "calculate": "datum.format=='physical' ? datum.phys_share : 1",  // new column calculated with this formula
      "as": "y1"  // name of the new column: y1
    },
    {  // transform step 11
      "calculate": "datum.format=='physical' ? 'Physical' : 'Digital'",  // new column calculated with this formula
      "as": "Format"  // name of the new column: Format
    },
    {  // transform step 12
      "calculate": "(datum.x0+datum.x1)/2",  // new column calculated with this formula
      "as": "xm"  // name of the new column: xm
    },
    {  // transform step 13
      "calculate": "(datum.y0+datum.y1)/2",  // new column calculated with this formula
      "as": "ym"  // name of the new column: ym
    },
    {  // transform step 14
      "calculate": "format(datum.format=='physical' ? datum.phys_share : 1-datum.phys_share, '.0%')",  // new column calculated with this formula
      "as": "pct"  // name of the new column: pct
    }
  ],
  "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
    {  // --- LAYER 1 ---
      "description": "LAYER 1 - THE BLOCKS: rectangles from x0 to x1 and y0 to y1, coloured by format. Hover shows every state's figures, including the three thin columns. CHANNELS: x position = x0 (quantitative); x end = x1; y position = y0 (quantitative); y end = y1; colour = Format (nominal).",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "rect",  // shape / type: rect
        "stroke": "white",  // colour white
        "strokeWidth": 1.5  // line / outline thickness 1.5px
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "x0",  // uses the 'x0' column
          "type": "quantitative",  // data type: numbers
          "title": "Share of all items borrowed in Australia",  // title shown: Share of all items borrowed in Australia
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": [0, 1]  // range of data values shown
          },
          "axis": {  // axis settings
            "format": "%",  // number format: %
            "tickCount": 5,  // roughly how many ticks / gridlines: 5
            "grid": false,  // show gridlines
            "titleFontWeight": 400,  // boldness of the axis title
            "titleColor": "#8a8378",  // colour of the axis title
            "titleAnchor": "middle"  // 'titleAnchor' = "middle"
          }
        },
        "x2": {  // where the shape ends on x
          "field": "x1"  // uses the 'x1' column
        },
        "y": {  // y position (up and down)
          "field": "y0",  // uses the 'y0' column
          "type": "quantitative",  // data type: numbers
          "title": "Share of the state's loans",  // title shown: Share of the state's loans
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": [0, 1]  // range of data values shown
          },
          "axis": {  // axis settings
            "format": "%",  // number format: %
            "tickCount": 5,  // roughly how many ticks / gridlines: 5
            "grid": false,  // show gridlines
            "titleFontWeight": 400,  // boldness of the axis title
            "titleColor": "#8a8378"  // colour of the axis title
          }
        },
        "y2": {  // where the shape ends on y
          "field": "y1"  // uses the 'y1' column
        },
        "color": {  // colour
          "field": "Format",  // uses the 'Format' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": ["Physical", "Digital"],  // range of data values shown
            "range": ["#c0532b", "#13827f"]  // the visual values used (colours / sizes)
          },
          "legend": {  // legend settings
            "orient": "top",  // which side it sits on
            "title": null,  // no title
            "direction": "horizontal"  // horizontal or vertical legend
          }
        },
        "tooltip": [  // what appears in the hover box
          {  // one row in the hover box
            "field": "state",  // uses the 'state' column
            "title": "State"  // title shown: State
          },
          {  // one row in the hover box
            "field": "Format"  // uses the 'Format' column
          },
          {  // one row in the hover box
            "field": "pct",  // uses the 'pct' column
            "title": "Share of the state's loans"  // title shown: Share of the state's loans
          },
          {  // one row in the hover box
            "field": "millions",  // uses the 'millions' column
            "title": "Items (millions)",  // title shown: Items (millions)
            "format": ".1f"  // number format: .1f
          }
        ]
      }
    },
    {  // --- LAYER 2 ---
      "description": "LAYER 2 - PERCENTAGE INSIDE EVERY BLOCK of the five big states (physical and digital). CHANNELS: x position = xm (quantitative); y position = ym (quantitative); text = pct.",  // plain-English note about this block (does not change the chart)
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "filter": "!datum.small"  // keep only rows where this is true
        }
      ],
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "color": "white",  // colour white
        "fontWeight": "bold",  // text boldness
        "fontSize": 14  // text size (px): 14
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "xm",  // uses the 'xm' column
          "type": "quantitative"  // data type: numbers
        },
        "y": {  // y position (up and down)
          "field": "ym",  // uses the 'ym' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "pct"  // uses the 'pct' column
        }
      }
    },
    {  // --- LAYER 3 ---
      "description": "LAYER 3 - STATE NAME at the bottom of each big state's column. CHANNELS: x position = xm (quantitative); text = abbr.",  // plain-English note about this block (does not change the chart)
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "filter": "!datum.small && datum.format=='physical'"  // keep only rows where this is true
        }
      ],
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "color": "white",  // colour white
        "fontWeight": "bold",  // text boldness
        "fontSize": 15,  // text size (px): 15
        "baseline": "bottom",  // vertical text alignment
        "dy": -8  // nudge up (negative) or down (px): -8
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "xm",  // uses the 'xm' column
          "type": "quantitative"  // data type: numbers
        },
        "y": {  // y position (up and down)
          "datum": 0  // 'datum' = 0
        },
        "text": {  // the text shown
          "field": "abbr"  // uses the 'abbr' column
        }
      }
    }
  ]
}
