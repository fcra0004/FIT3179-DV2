// COMMENTED COPY of specs/s3_bump_slope_state_borrowing_ranks.vg.json, for reading only. The page loads specs/s3_bump_slope_state_borrowing_ranks.vg.json.
// JSON files can't contain comments, so the comments live in this copy instead.

{  // the whole chart
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // which version of Vega-Lite / Vega this file is written for
  "description": "CHART PAIR: 'State rank by items borrowed per person' (bump chart, left) + 'Items per person, a decade later' (slope chart, right). Section 3, second card. The 'hover' param below is shared by both charts: hovering a state's line in either chart fades every other state (see 'opacity' in each chart).",  // plain-English note about this block (does not change the chart)
  "params": [  // PARAMS: interactive controls and selections
    {  // param 1
      "name": "hover",  // name 'hover' that other parts of the spec use to refer to this
      "select": {  // records what the user clicks or hovers
        "type": "point",  // point selection: pick single items
        "fields": ["state"],  // what gets remembered when you select something
        "on": "pointerover",  // the mouse/touch event that triggers it
        "clear": "pointerout"  // event that clears the selection
      },
      "views": ["bumpLines", "slopeLines"]  // which named chart layers listen for this selection
    }
  ],
  "hconcat": [  // charts placed side by side
    {  // --- CHART 1 (from the left) ---
      "description": "LEFT CHART - BUMP CHART: each state's rank by items borrowed per person, 2010-11 to 2015-16. The 'window' transform calculates the rank (1 = most) within each year. CHANNELS: x position = year (ordinal); y position = rank (ordinal); colour = state (nominal); opacity changes when selected in hover.",  // plain-English note about this block (does not change the chart)
      "name": "bump",  // name 'bump' that other parts of the spec use to refer to this
      "width": 330,  // width in pixels
      "height": 280,  // height in pixels
      "title": {  // chart title
        "text": "State rank by items borrowed per person",  // the text
        "fontSize": 16  // text size (px): 16
      },
      "data": {  // DATA: where this chart's rows come from
        "url": "data/state_loans_per_person_2010_2016.csv",  // load the file data/state_loans_per_person_2010_2016.csv
        "format": {  // how to read the file
          "parse": {  // treat these columns as numbers, not text
            "loans_per_person": "number"  // read the 'loans_per_person' column as a number
          }
        }
      },
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "window": [  // calculate across neighbouring rows (e.g. rank)
            {  // the calculation to do
              "op": "rank",  // operation: rank
              "as": "rank"  // name of the new column: rank
            }
          ],
          "groupby": ["year"],  // do it separately for each value of these columns
          "sort": [  // order of the items
            {  // sort rule
              "field": "loans_per_person",  // uses the 'loans_per_person' column
              "order": "descending"  // sort descending (highest first)
            }
          ]
        }
      ],
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "year",  // uses the 'year' column
          "type": "ordinal",  // data type: ordered categories (e.g. years, age groups)
          "title": "Financial year",  // title shown: Financial year
          "axis": {  // axis settings
            "labelAngle": 0,  // tilt the labels (degrees): 0
            "labelExpr": "slice(datum.label,2,4)+'–'+slice(datum.label,5,7)"  // rewrite each label, e.g. 2014-15 becomes 14–15
          }
        },
        "y": {  // y position (up and down)
          "field": "rank",  // uses the 'rank' column
          "type": "ordinal",  // data type: ordered categories (e.g. years, age groups)
          "title": "Rank",  // title shown: Rank
          "axis": {  // axis settings
            "labelExpr": "'#'+datum.label"  // rewrite each label, e.g. 2014-15 becomes 14–15
          }
        },
        "color": {  // colour
          "field": "state",  // uses the 'state' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],  // range of data values shown
            "range": ["#5b7fb3", "#d1495b", "#66a5ad", "#e8a33d", "#3f7d4e", "#9c6ba8", "#c9b03a", "#8d6a4f"]  // the visual values used (colours / sizes)
          },
          "legend": null  // no legend (things are labelled directly)
        },
        "opacity": {  // transparency
          "condition": {  // IF the rule below is true, use this value...
            "param": "hover",  // ...the 'hover' selection
            "empty": true,  // what to do when nothing is selected
            "value": 1  // ...then use 1
          },
          "value": 0.15  // OTHERWISE use 0.15
        }
      },
      "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
        {  // --- LAYER 1 ---
          "description": "BUMP LAYER 1 - THE RANK LINES (one per state). Named 'bumpLines' so the hover param can listen to it.",  // plain-English note about this block (does not change the chart)
          "name": "bumpLines",  // name 'bumpLines' that other parts of the spec use to refer to this
          "mark": {  // MARK: the shape drawn for each row
            "type": "line",  // shape / type: line
            "strokeWidth": 3,  // line / outline thickness 3px
            "interpolate": "monotone"  // how lines bend between points (monotone = smooth curves)
          }
        },
        {  // --- LAYER 2 ---
          "description": "BUMP LAYER 2 - DOTS on each year + tooltip.",  // plain-English note about this block (does not change the chart)
          "name": "bumpDots",  // name 'bumpDots' that other parts of the spec use to refer to this
          "mark": {  // MARK: the shape drawn for each row
            "type": "circle",  // shape / type: circle
            "size": 90  // size 90
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "tooltip": [  // what appears in the hover box
              {  // one row in the hover box
                "field": "state",  // uses the 'state' column
                "title": "State"  // title shown: State
              },
              {  // one row in the hover box
                "field": "year",  // uses the 'year' column
                "title": "Year"  // title shown: Year
              },
              {  // one row in the hover box
                "field": "loans_per_person",  // uses the 'loans_per_person' column
                "title": "Items per person"  // title shown: Items per person
              },
              {  // one row in the hover box
                "field": "rank",  // uses the 'rank' column
                "title": "Rank"  // title shown: Rank
              }
            ]
          }
        },
        {  // --- LAYER 3 ---
          "description": "BUMP LAYER 3 - STATE NAMES at the right end (2015-16). CHANNELS: text = state.",  // plain-English note about this block (does not change the chart)
          "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
            {  // transform step 1
              "filter": "datum.year=='2015-16'"  // keep only rows where this is true
            }
          ],
          "mark": {  // MARK: the shape drawn for each row
            "type": "text",  // shape / type: text
            "align": "left",  // text alignment
            "dx": 9,  // nudge sideways (px): 9
            "fontWeight": "bold",  // text boldness
            "fontSize": 12  // text size (px): 12
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "text": {  // the text shown
              "field": "state"  // uses the 'state' column
            }
          }
        }
      ]
    },
    {  // --- CHART 2 (from the left) ---
      "description": "RIGHT CHART - SLOPE CHART: items borrowed per person in 2014-15 vs 2024-25 for each state. CHANNELS: x position = year (ordinal); colour = state (nominal); opacity changes when selected in hover.",  // plain-English note about this block (does not change the chart)
      "name": "slope",  // name 'slope' that other parts of the spec use to refer to this
      "width": 208,  // width in pixels
      "height": 280,  // height in pixels
      "title": {  // chart title
        "text": "Items per person, a decade later",  // the text
        "fontSize": 16  // text size (px): 16
      },
      "data": {  // DATA: where this chart's rows come from
        "url": "data/state_loans_slope.csv",  // load the file data/state_loans_slope.csv
        "format": {  // how to read the file
          "parse": {  // treat these columns as numbers, not text
            "loans_per_person": "number",  // read the 'loans_per_person' column as a number
            "label_y": "number"  // read the 'label_y' column as a number
          }
        }
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "year",  // uses the 'year' column
          "type": "ordinal",  // data type: ordered categories (e.g. years, age groups)
          "title": "Financial year",  // title shown: Financial year
          "axis": {  // axis settings
            "labelAngle": 0,  // tilt the labels (degrees): 0
            "domain": false,  // range of data values shown
            "ticks": false,  // show tick marks
            "labelExpr": "slice(datum.label,2,4)+'–'+slice(datum.label,5,7)"  // rewrite each label, e.g. 2014-15 becomes 14–15
          },
          "scale": {  // how data values are turned into positions, colours or sizes
            "padding": 0.25  // space at the ends
          }
        },
        "color": {  // colour
          "field": "state",  // uses the 'state' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],  // range of data values shown
            "range": ["#5b7fb3", "#d1495b", "#66a5ad", "#e8a33d", "#3f7d4e", "#9c6ba8", "#c9b03a", "#8d6a4f"]  // the visual values used (colours / sizes)
          },
          "legend": null  // no legend (things are labelled directly)
        },
        "opacity": {  // transparency
          "condition": {  // IF the rule below is true, use this value...
            "param": "hover",  // ...the 'hover' selection
            "empty": true,  // what to do when nothing is selected
            "value": 1  // ...then use 1
          },
          "value": 0.15  // OTHERWISE use 0.15
        }
      },
      "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
        {  // --- LAYER 1 ---
          "description": "SLOPE LAYER 1 - THE SLOPE LINES (one per state). Named 'slopeLines' so the hover param can listen to it. CHANNELS: y position = loans_per_person (quantitative); one line per = state.",  // plain-English note about this block (does not change the chart)
          "name": "slopeLines",  // name 'slopeLines' that other parts of the spec use to refer to this
          "mark": {  // MARK: the shape drawn for each row
            "type": "line",  // shape / type: line
            "strokeWidth": 3  // line / outline thickness 3px
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "y": {  // y position (up and down)
              "field": "loans_per_person",  // uses the 'loans_per_person' column
              "type": "quantitative",  // data type: numbers
              "title": "Items per person",  // title shown: Items per person
              "scale": {  // how data values are turned into positions, colours or sizes
                "domain": [2, 9.5]  // range of data values shown
              },
              "axis": {  // axis settings
                "tickCount": 6,  // roughly how many ticks / gridlines: 6
                "grid": true,  // show gridlines
                "domain": false,  // range of data values shown
                "ticks": false,  // show tick marks
                "labelFlush": true  // 'labelFlush' = true
              }
            },
            "detail": {  // draw one separate line per value
              "field": "state"  // uses the 'state' column
            }
          }
        },
        {  // --- LAYER 2 ---
          "description": "SLOPE LAYER 2 - DOTS at each end + tooltip. CHANNELS: y position = loans_per_person (quantitative).",  // plain-English note about this block (does not change the chart)
          "name": "slopeDots",  // name 'slopeDots' that other parts of the spec use to refer to this
          "mark": {  // MARK: the shape drawn for each row
            "type": "circle",  // shape / type: circle
            "size": 70  // size 70
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "y": {  // y position (up and down)
              "field": "loans_per_person",  // uses the 'loans_per_person' column
              "type": "quantitative"  // data type: numbers
            },
            "tooltip": [  // what appears in the hover box
              {  // one row in the hover box
                "field": "state",  // uses the 'state' column
                "title": "State"  // title shown: State
              },
              {  // one row in the hover box
                "field": "year",  // uses the 'year' column
                "title": "Year"  // title shown: Year
              },
              {  // one row in the hover box
                "field": "loans_per_person",  // uses the 'loans_per_person' column
                "title": "Items per person"  // title shown: Items per person
              }
            ]
          }
        },
        {  // --- LAYER 3 ---
          "description": "SLOPE LAYER 3 - LABELS at the right end, e.g. 'SA 9.0'. label_y in the CSV nudges labels apart so they don't overlap. CHANNELS: y position = label_y (quantitative); text = lab.",  // plain-English note about this block (does not change the chart)
          "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
            {  // transform step 1
              "filter": "datum.year=='2024-25'"  // keep only rows where this is true
            },
            {  // transform step 2
              "calculate": "datum.state+' '+format(datum.loans_per_person,'.1f')",  // new column calculated with this formula
              "as": "lab"  // name of the new column: lab
            }
          ],
          "mark": {  // MARK: the shape drawn for each row
            "type": "text",  // shape / type: text
            "align": "left",  // text alignment
            "dx": 8,  // nudge sideways (px): 8
            "fontSize": 12  // text size (px): 12
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "y": {  // y position (up and down)
              "field": "label_y",  // uses the 'label_y' column
              "type": "quantitative"  // data type: numbers
            },
            "text": {  // the text shown
              "field": "lab"  // uses the 'lab' column
            }
          }
        }
      ]
    }
  ],
  "spacing": 36  // gap between the side-by-side charts (px): 36
}
