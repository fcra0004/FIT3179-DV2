// COMMENTED COPY of specs/s5_heatmap_bars_programs_by_age.vg.json, for reading only. The page loads specs/s5_heatmap_bars_programs_by_age.vg.json.
// JSON files can't contain comments, so the comments live in this copy instead.

{  // the whole chart
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // which version of Vega-Lite / Vega this file is written for
  "description": "CHART PAIR: 'Program attendances per 1,000 residents (2024-25)' (heatmap, left) + '<group>: why they attend' (bars, right). Section 5. Clicking a row of the heatmap (param 'paud') picks an age group; the bars show that group's reasons for attending.",  // plain-English note about this block (does not change the chart)
  "hconcat": [  // charts placed side by side
    {  // --- CHART 1 (from the left) ---
      "description": "LEFT CHART - HEATMAP: states across the top, age groups down the side. The transform calculates attendances per 1,000 residents (per_1000), which sets the colour. CHANNELS: y position = audience (nominal); x position = abbr (nominal).",  // plain-English note about this block (does not change the chart)
      "name": "heat",  // name 'heat' that other parts of the spec use to refer to this
      "width": 360,  // width in pixels
      "height": 270,  // height in pixels
      "title": {  // chart title
        "text": "Program attendances per 1,000 residents (2024–25)",  // the text
        "fontSize": 16  // text size (px): 16
      },
      "data": {  // DATA: where this chart's rows come from
        "url": "data/programs_by_audience_2024_25.csv",  // load the file data/programs_by_audience_2024_25.csv
        "format": {  // how to read the file
          "parse": {  // treat these columns as numbers, not text
            "participants": "number",  // read the 'participants' column as a number
            "population_millions": "number"  // read the 'population_millions' column as a number
          }
        }
      },
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "calculate": "datum.participants / (datum.population_millions*1000)",  // new column calculated with this formula
          "as": "per_1000"  // name of the new column: per_1000
        }
      ],
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "audience",  // uses the 'audience' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "title": null,  // no title
          "sort": ["Early childhood", "Children", "Young adult", "Adults", "Seniors", "All ages"],  // order of the items
          "axis": {  // axis settings
            "domain": false,  // range of data values shown
            "ticks": false,  // show tick marks
            "labelFontSize": 13,  // label text size
            "labelPadding": 9,  // gap between labels and the chart
            "labelExpr": "datum.label=='Early childhood' ? 'Under 5s' : datum.label=='Young adult' ? 'Teens' : datum.label"  // rewrite each label, e.g. 2014-15 becomes 14–15
          }
        },
        "x": {  // x position (left to right)
          "field": "abbr",  // uses the 'abbr' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "title": null,  // no title
          "axis": {  // axis settings
            "labelAngle": 0,  // tilt the labels (degrees): 0
            "orient": "top",  // which side it sits on
            "domain": false,  // range of data values shown
            "ticks": false,  // show tick marks
            "labelFontSize": 12  // label text size
          }
        }
      },
      "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
        {  // --- LAYER 1 ---
          "description": "HEATMAP LAYER 1 - THE COLOURED SQUARES + THE CLICK. 'paud' records the clicked age group (starts on Early childhood = Under 5s). Colour: pale to dark plum, square-root scale so small values still differ. CHANNELS: colour = per_1000 (quantitative).",  // plain-English note about this block (does not change the chart)
          "params": [  // PARAMS: interactive controls and selections
            {  // param 1
              "name": "paud",  // name 'paud' that other parts of the spec use to refer to this
              "select": {  // records what the user clicks or hovers
                "type": "point",  // point selection: pick single items
                "fields": ["audience"],  // what gets remembered when you select something
                "toggle": false  // false = a click replaces the selection instead of adding to it
              },
              "value": [  // starting value
                {  // selected when the page first loads
                  "audience": "Early childhood"  // 'audience' = "Early childhood"
                }
              ]
            }
          ],
          "mark": {  // MARK: the shape drawn for each row
            "type": "rect",  // shape / type: rect
            "stroke": "white",  // colour white
            "strokeWidth": 2,  // line / outline thickness 2px
            "cursor": "pointer"  // mouse cursor over this shape (pointer = hand, shows it's clickable)
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "color": {  // colour
              "field": "per_1000",  // uses the 'per_1000' column
              "type": "quantitative",  // data type: numbers
              "title": "Per 1,000",  // title shown: Per 1,000
              "scale": {  // how data values are turned into positions, colours or sizes
                "type": "sqrt",  // sqrt scale (square root, so small values still show differences)
                "range": ["#f6e3ec", "#a33b6a", "#5c1435"]  // the visual values used (colours / sizes)
              },
              "legend": null  // no legend (things are labelled directly)
            },
            "tooltip": [  // what appears in the hover box
              {  // one row in the hover box
                "field": "state",  // uses the 'state' column
                "title": "State"  // title shown: State
              },
              {  // one row in the hover box
                "field": "audience",  // uses the 'audience' column
                "title": "Audience"  // title shown: Audience
              },
              {  // one row in the hover box
                "field": "participants",  // uses the 'participants' column
                "title": "Attendances",  // title shown: Attendances
                "format": ","  // number format: ,
              },
              {  // one row in the hover box
                "field": "per_1000",  // uses the 'per_1000' column
                "title": "Per 1,000 residents",  // title shown: Per 1,000 residents
                "format": ".0f"  // number format: .0f
              }
            ]
          }
        },
        {  // --- LAYER 2 ---
          "description": "HEATMAP LAYER 2 - THE NUMBER IN EACH SQUARE (white on dark squares, dark on light ones). CHANNELS: text = per_1000; colour changes when datum.per_1000 > 70.",  // plain-English note about this block (does not change the chart)
          "mark": {  // MARK: the shape drawn for each row
            "type": "text",  // shape / type: text
            "fontSize": 12  // text size (px): 12
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "text": {  // the text shown
              "field": "per_1000",  // uses the 'per_1000' column
              "format": ".0f"  // number format: .0f
            },
            "color": {  // colour
              "condition": {  // IF the rule below is true, use this value...
                "test": "datum.per_1000 > 70",  // IF this formula is true
                "value": "white"  // ...then use "white"
              },
              "value": "#2d2a26"  // OTHERWISE use "#2d2a26"
            }
          }
        },
        {  // --- LAYER 3 ---
          "description": "HEATMAP LAYER 3 - THE DARK OUTLINE around the selected row. It only keeps the clicked group (filter on 'paud') and draws one unfilled rectangle across the full row.",  // plain-English note about this block (does not change the chart)
          "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
            {  // transform step 1
              "filter": {  // keep only rows picked in the 'paud' selection
                "param": "paud",  // ...the 'paud' selection
                "empty": false  // what to do when nothing is selected
              }
            },
            {  // transform step 2
              "aggregate": [  // add up or count rows
                {  // the calculation to do
                  "op": "count",  // operation: count
                  "as": "n"  // name of the new column: n
                }
              ],
              "groupby": ["audience"]  // do it separately for each value of these columns
            }
          ],
          "mark": {  // MARK: the shape drawn for each row
            "type": "rect",  // shape / type: rect
            "fill": null,  // 'fill' = null
            "stroke": "#2d2a26",  // colour #2d2a26
            "strokeWidth": 3,  // line / outline thickness 3px
            "cornerRadius": 2  // rounded corners (px)
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "x": null  // x position (left to right): switched off for this layer
          }
        }
      ]
    },
    {  // --- CHART 2 (from the left) ---
      "description": "RIGHT CHART - '<group>: why they attend' BARS: share of the selected group's attendances by program purpose. Transforms: keep the clicked group, add up attendances per purpose, then divide by the group total to get each share. CHANNELS: y position = outcome (nominal); x position = share (quantitative).",  // plain-English note about this block (does not change the chart)
      "name": "outcomes",  // name 'outcomes' that other parts of the spec use to refer to this
      "width": 218,  // width in pixels
      "height": 270,  // height in pixels
      "title": {  // chart title
        "text": {  // the text
          "expr": "(paud && paud.audience ? (paud.audience[0]=='Early childhood' ? 'Under 5s' : paud.audience[0]=='Young adult' ? 'Teens' : paud.audience[0]) : 'Everyone') + ': why they attend'"  // value calculated from this formula
        },
        "fontSize": 16,  // text size (px): 16
        "offset": 27  // gap under the title
      },
      "data": {  // DATA: where this chart's rows come from
        "url": "data/programs_purpose_by_audience_2024_25.csv",  // load the file data/programs_purpose_by_audience_2024_25.csv
        "format": {  // how to read the file
          "parse": {  // treat these columns as numbers, not text
            "participants": "number"  // read the 'participants' column as a number
          }
        }
      },
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "filter": {  // keep only rows picked in the 'paud' selection
            "param": "paud"  // ...the 'paud' selection
          }
        },
        {  // transform step 2
          "aggregate": [  // add up or count rows
            {  // the calculation to do
              "op": "sum",  // operation: sum
              "field": "participants",  // uses the 'participants' column
              "as": "p"  // name of the new column: p
            }
          ],
          "groupby": ["outcome"]  // do it separately for each value of these columns
        },
        {  // transform step 3
          "joinaggregate": [  // add a total to every row without merging rows
            {  // the calculation to do
              "op": "sum",  // operation: sum
              "field": "p",  // uses the 'p' column
              "as": "tot"  // name of the new column: tot
            }
          ]
        },
        {  // transform step 4
          "calculate": "datum.p/datum.tot",  // new column calculated with this formula
          "as": "share"  // name of the new column: share
        }
      ],
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "outcome",  // uses the 'outcome' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "title": null,  // no title
          "sort": {  // order of the items
            "field": "share",  // uses the 'share' column
            "order": "descending"  // sort descending (highest first)
          },
          "axis": null,  // no axis (labels are drawn on the chart instead)
          "scale": {  // how data values are turned into positions, colours or sizes
            "paddingInner": 0.55,  // gap between bars or rows
            "paddingOuter": 0.3  // space before the first and after the last item
          }
        },
        "x": {  // x position (left to right)
          "field": "share",  // uses the 'share' column
          "type": "quantitative",  // data type: numbers
          "title": null,  // no title
          "axis": null,  // no axis (labels are drawn on the chart instead)
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": [0, 1.05]  // range of data values shown
          }
        }
      },
      "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
        {  // --- LAYER 1 ---
          "description": "BARS LAYER 1 - THE BARS (length = share).",  // plain-English note about this block (does not change the chart)
          "mark": {  // MARK: the shape drawn for each row
            "type": "bar",  // shape / type: bar
            "color": "#a33b6a",  // colour #a33b6a
            "cornerRadiusEnd": 3  // rounded end of each bar (px)
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "tooltip": [  // what appears in the hover box
              {  // one row in the hover box
                "field": "outcome",  // uses the 'outcome' column
                "title": "Purpose"  // title shown: Purpose
              },
              {  // one row in the hover box
                "field": "p",  // uses the 'p' column
                "title": "Attendances",  // title shown: Attendances
                "format": ","  // number format: ,
              },
              {  // one row in the hover box
                "field": "share",  // uses the 'share' column
                "title": "Share",  // title shown: Share
                "format": ".0%"  // number format: .0%
              }
            ]
          }
        },
        {  // --- LAYER 2 ---
          "description": "BARS LAYER 2 - THE % LABEL at the end of each bar. CHANNELS: text = share.",  // plain-English note about this block (does not change the chart)
          "mark": {  // MARK: the shape drawn for each row
            "type": "text",  // shape / type: text
            "align": "left",  // text alignment
            "dx": 5,  // nudge sideways (px): 5
            "fontSize": 13,  // text size (px): 13
            "fontWeight": "bold",  // text boldness
            "color": "#a33b6a"  // colour #a33b6a
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "text": {  // the text shown
              "field": "share",  // uses the 'share' column
              "format": ".0%"  // number format: .0%
            }
          }
        },
        {  // --- LAYER 3 ---
          "description": "BARS LAYER 3 - THE PURPOSE NAME above each bar (used instead of an axis). CHANNELS: text = outcome; x position fixed at 0.",  // plain-English note about this block (does not change the chart)
          "mark": {  // MARK: the shape drawn for each row
            "type": "text",  // shape / type: text
            "align": "left",  // text alignment
            "baseline": "bottom",  // vertical text alignment
            "dy": -9,  // nudge up (negative) or down (px): -9
            "fontSize": 13,  // text size (px): 13
            "color": "#2d2a26"  // colour #2d2a26
          },
          "encoding": {  // ENCODING: which data column controls which visual channel
            "text": {  // the text shown
              "field": "outcome"  // uses the 'outcome' column
            },
            "x": {  // x position (left to right)
              "value": 0  // OTHERWISE use 0
            }
          }
        }
      ]
    }
  ],
  "spacing": 40,  // gap between the side-by-side charts (px): 40
  "resolve": {  // let each chart keep its own scales/legends instead of sharing
    "scale": {  // how data values are turned into positions, colours or sizes
      "color": "independent"  // colour independent
    }
  }
}
