// COMMENTED COPY of specs/s2_bar_library_visits_by_age.vg.json, for reading only. The page loads specs/s2_bar_library_visits_by_age.vg.json.
// JSON files can't contain comments, so the comments live in this copy instead.

{  // the whole chart
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // which version of Vega-Lite / Vega this file is written for
  "description": "CHART: 'Share of each age group who visited a library (2021-22)' (Section 2, top card). Bar chart of the share of each age group who visited a library in 2021-22 (ABS). The data is typed into this file under \"values\". The transform makes a true/false column 'young' for the 18-24 and 25-34 bars so they can be coloured amber. CHANNELS: x position = age (ordinal); y position = pct (quantitative).",  // plain-English note about this block (does not change the chart)
  "title": "Share of each age group who visited a library (2021–22)",  // title shown: Share of each age group who visited a library (2021–22)
  "width": 669,  // width in pixels
  "height": 230,  // height in pixels
  "data": {  // DATA: where this chart's rows come from
    "values": [  // rows typed straight into this file
      {"age": "15–17", "pct": 28.4},  // data row 1
      {"age": "18–24", "pct": 18.2},  // data row 2
      {"age": "25–34", "pct": 19.1},  // data row 3
      {"age": "35–44", "pct": 23.8},  // data row 4
      {"age": "45–54", "pct": 19.0},  // data row 5
      {"age": "55–64", "pct": 16.9},  // data row 6
      {"age": "65–74", "pct": 22.5},  // data row 7
      {"age": "75+", "pct": 20.0}  // data row 8
    ]
  },
  "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
    {  // transform step 1
      "calculate": "datum.age=='18–24' || datum.age=='25–34'",  // new column calculated with this formula
      "as": "young"  // name of the new column: young
    }
  ],
  "encoding": {  // ENCODING: which data column controls which visual channel
    "x": {  // x position (left to right)
      "field": "age",  // uses the 'age' column
      "type": "ordinal",  // data type: ordered categories (e.g. years, age groups)
      "title": "Age",  // title shown: Age
      "sort": null,  // order of the items
      "axis": {  // axis settings
        "labelAngle": 0,  // tilt the labels (degrees): 0
        "titleFontWeight": 400,  // boldness of the axis title
        "titleColor": "#8a8378"  // colour of the axis title
      }
    },
    "y": {  // y position (up and down)
      "field": "pct",  // uses the 'pct' column
      "type": "quantitative",  // data type: numbers
      "title": "Visited a library",  // title shown: Visited a library
      "scale": {  // how data values are turned into positions, colours or sizes
        "domain": [0, 32]  // range of data values shown
      },
      "axis": {  // axis settings
        "labelExpr": "datum.label+'%'",  // rewrite each label, e.g. 2014-15 becomes 14–15
        "tickCount": 4  // roughly how many ticks / gridlines: 4
      }
    }
  },
  "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
    {  // --- LAYER 1 ---
      "description": "LAYER 1 - THE BARS. x = age group, y = % who visited (bar length). colour: amber when young = true, beige otherwise. CHANNELS: colour = young (nominal).",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "bar",  // shape / type: bar
        "width": {  // bar width as a share of each slot
          "band": 0.62  // 62% of the slot
        },
        "cornerRadiusTopLeft": 3,  // rounded top-left corner
        "cornerRadiusTopRight": 3  // rounded top-right corner
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "color": {  // colour
          "field": "young",  // uses the 'young' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": [true, false],  // range of data values shown
            "range": ["#d4901c", "#e9dcc4"]  // the visual values used (colours / sizes)
          },
          "legend": null  // no legend (things are labelled directly)
        },
        "tooltip": [  // what appears in the hover box
          {  // one row in the hover box
            "field": "age",  // uses the 'age' column
            "title": "Age"  // title shown: Age
          },
          {  // one row in the hover box
            "field": "pct",  // uses the 'pct' column
            "title": "Visited a library (%)"  // title shown: Visited a library (%)
          }
        ]
      }
    },
    {  // --- LAYER 2 ---
      "description": "LAYER 2 - NUMBER ON TOP OF EACH BAR (e.g. '18'). dy:-8 lifts the label above the bar. CHANNELS: text = pct; colour changes when datum.young.",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "dy": -8,  // nudge up (negative) or down (px): -8
        "fontSize": 13,  // text size (px): 13
        "fontWeight": "bold"  // text boldness
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "text": {  // the text shown
          "field": "pct",  // uses the 'pct' column
          "format": ".0f"  // number format: .0f
        },
        "color": {  // colour
          "condition": {  // IF the rule below is true, use this value...
            "test": "datum.young",  // IF this formula is true
            "value": "#a86a08"  // ...then use "#a86a08"
          },
          "value": "#8a8378"  // OTHERWISE use "#8a8378"
        }
      }
    },
    {  // --- LAYER 3 ---
      "description": "LAYER 3 - ANNOTATION 'Under 35s: fewer than 1 in 5' placed above the 18-24 bar. CHANNELS: x position = age (ordinal); y position = pct (quantitative); text = t.",  // plain-English note about this block (does not change the chart)
      "data": {  // DATA: where this chart's rows come from
        "values": [  // rows typed straight into this file
          {"age": "18–24", "pct": 27, "t": "Under 35s: fewer than 1 in 5"}  // data row 1
        ]
      },
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "align": "left",  // text alignment
        "dx": -14,  // nudge sideways (px): -14
        "fontSize": 13,  // text size (px): 13
        "fontStyle": "italic",  // italic or normal
        "color": "#a86a08"  // colour #a86a08
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "x": {  // x position (left to right)
          "field": "age",  // uses the 'age' column
          "type": "ordinal"  // data type: ordered categories (e.g. years, age groups)
        },
        "y": {  // y position (up and down)
          "field": "pct",  // uses the 'pct' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "t"  // uses the 't' column
        }
      }
    }
  ]
}
