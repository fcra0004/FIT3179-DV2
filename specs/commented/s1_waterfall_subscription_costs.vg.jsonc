// COMMENTED COPY of specs/s1_waterfall_subscription_costs.vg.json, for reading only. The page loads specs/s1_waterfall_subscription_costs.vg.json.
// JSON files can't contain comments, so the comments live in this copy instead.

{  // the whole chart
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // which version of Vega-Lite / Vega this file is written for
  "description": "CHART: 'Yearly cost of apps a library card covers for free (A$)' - its title is written in index.html so the checkboxes can sit under it (Section 1). Waterfall chart: each red bar adds one app's yearly cost on top of the last, the dark bar is the total, and the library card is $0. PARAMS: four checkboxes (kindle, audible, news, mubi) - unticking one sets its cost to 0. TRANSFORMS: 'ticked' checks the box for each app, 'yearly' = monthly price x 12 (or 0 if unticked), the window sum gives each bar's top ('end'), and 'start' = end - yearly gives its bottom. 'next' names the following bar so the dashed connector line knows where to go. CHANNELS: x position = service (nominal).",  // plain-English note about this block (does not change the chart)
  "width": 685,  // width in pixels
  "height": 300,  // height in pixels
  "params": [  // PARAMS: interactive controls and selections
    {  // param 1
      "name": "kindle",  // name 'kindle' that other parts of the spec use to refer to this
      "value": true,  // use this value: true
      "bind": {  // connects this param to an input control on the page
        "input": "checkbox",  // type of control
        "name": "Kindle Unlimited"  // label shown next to the control: Kindle Unlimited
      }
    },
    {  // param 2
      "name": "audible",  // name 'audible' that other parts of the spec use to refer to this
      "value": true,  // use this value: true
      "bind": {  // connects this param to an input control on the page
        "input": "checkbox",  // type of control
        "name": "Audible Premium"  // label shown next to the control: Audible Premium
      }
    },
    {  // param 3
      "name": "news",  // name 'news' that other parts of the spec use to refer to this
      "value": true,  // use this value: true
      "bind": {  // connects this param to an input control on the page
        "input": "checkbox",  // type of control
        "name": "Apple News+"  // label shown next to the control: Apple News+
      }
    },
    {  // param 4
      "name": "mubi",  // name 'mubi' that other parts of the spec use to refer to this
      "value": true,  // use this value: true
      "bind": {  // connects this param to an input control on the page
        "input": "checkbox",  // type of control
        "name": "MUBI"  // label shown next to the control: MUBI
      }
    }
  ],
  "data": {  // DATA: where this chart's rows come from
    "url": "data/subscription_prices.csv",  // load the file data/subscription_prices.csv
    "format": {  // how to read the file
      "parse": {  // treat these columns as numbers, not text
        "monthly_aud": "number",  // read the 'monthly_aud' column as a number
        "order": "number"  // read the 'order' column as a number
      }
    }
  },
  "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
    {  // transform step 1
      "calculate": "(datum.key=='kindle' && kindle) || (datum.key=='audible' && audible) || (datum.key=='news' && news) || (datum.key=='mubi' && mubi)",  // new column calculated with this formula
      "as": "ticked"  // name of the new column: ticked
    },
    {  // transform step 2
      "calculate": "datum.ticked ? round(datum.monthly_aud*12) : 0",  // new column calculated with this formula
      "as": "yearly"  // name of the new column: yearly
    },
    {  // transform step 3
      "window": [  // calculate across neighbouring rows (e.g. rank)
        {  // the calculation to do
          "op": "sum",  // operation: sum
          "field": "yearly",  // uses the 'yearly' column
          "as": "end"  // name of the new column: end
        }
      ],
      "sort": [  // order of the items
        {  // sort rule
          "field": "order"  // uses the 'order' column
        }
      ],
      "frame": [null, 0]  // use every row in the group
    },
    {  // transform step 4
      "calculate": "datum.end - datum.yearly",  // new column calculated with this formula
      "as": "start"  // name of the new column: start
    },
    {  // transform step 5
      "window": [  // calculate across neighbouring rows (e.g. rank)
        {  // the calculation to do
          "op": "lead",  // operation: lead
          "field": "service",  // uses the 'service' column
          "as": "lead"  // name of the new column: lead
        }
      ],
      "sort": [  // order of the items
        {  // sort rule
          "field": "order"  // uses the 'order' column
        }
      ]
    },
    {  // transform step 6
      "calculate": "datum.order < 4 ? datum.lead : 'You pay'",  // new column calculated with this formula
      "as": "next"  // name of the new column: next
    }
  ],
  "encoding": {  // ENCODING: which data column controls which visual channel
    "x": {  // x position (left to right)
      "field": "service",  // uses the 'service' column
      "type": "nominal",  // data type: unordered categories (e.g. states)
      "title": null,  // no title
      "scale": {  // how data values are turned into positions, colours or sizes
        "domain": ["Kindle Unlimited", "Audible Premium", "Apple News+", "MUBI", "You pay", "Library card"],  // range of data values shown
        "paddingInner": 0.28  // gap between bars or rows
      },
      "axis": {  // axis settings
        "labelAngle": 0,  // tilt the labels (degrees): 0
        "domain": false,  // range of data values shown
        "ticks": false,  // show tick marks
        "labelFontSize": 13,  // label text size
        "labelFontWeight": 600,  // 'labelFontWeight' = 600
        "labelPadding": 8,  // gap between labels and the chart
        "labelExpr": "split(datum.label, ' ')",  // rewrite each label, e.g. 2014-15 becomes 14–15
        "labelLineHeight": 15  // 'labelLineHeight' = 15
      }
    }
  },
  "layer": [  // LAYERS: shapes drawn on top of each other, first item at the bottom
    {  // --- LAYER 1 ---
      "description": "LAYER 1 - THE FLOATING COST BARS: each runs from 'start' to 'end'. Unticked apps fade. CHANNELS: y position = start (quantitative); y end = end; opacity changes when datum.ticked.",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "bar",  // shape / type: bar
        "color": "#8f2d2d",  // colour #8f2d2d
        "cornerRadius": 2  // rounded corners (px)
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "start",  // uses the 'start' column
          "type": "quantitative",  // data type: numbers
          "title": null,  // no title
          "scale": {  // how data values are turned into positions, colours or sizes
            "domain": [0, 850]  // range of data values shown
          },
          "axis": {  // axis settings
            "labelExpr": "'$'+datum.label",  // rewrite each label, e.g. 2014-15 becomes 14–15
            "tickCount": 5,  // roughly how many ticks / gridlines: 5
            "domain": false,  // range of data values shown
            "ticks": false  // show tick marks
          }
        },
        "y2": {  // where the shape ends on y
          "field": "end"  // uses the 'end' column
        },
        "opacity": {  // transparency
          "condition": {  // IF the rule below is true, use this value...
            "test": "datum.ticked",  // IF this formula is true
            "value": 1  // ...then use 1
          },
          "value": 0.25  // OTHERWISE use 0.25
        },
        "tooltip": [  // what appears in the hover box
          {  // one row in the hover box
            "field": "service",  // uses the 'service' column
            "title": "App"  // title shown: App
          },
          {  // one row in the hover box
            "field": "covers",  // uses the 'covers' column
            "title": "For"  // title shown: For
          },
          {  // one row in the hover box
            "field": "monthly_aud",  // uses the 'monthly_aud' column
            "title": "A$ per month",  // title shown: A$ per month
            "format": ".2f"  // number format: .2f
          },
          {  // one row in the hover box
            "field": "yearly",  // uses the 'yearly' column
            "title": "A$ per year"  // title shown: A$ per year
          },
          {  // one row in the hover box
            "field": "library_alternative",  // uses the 'library_alternative' column
            "title": "Free with a library card via"  // title shown: Free with a library card via
          }
        ]
      }
    },
    {  // --- LAYER 2 ---
      "description": "LAYER 2 - DASHED CONNECTOR LINES from the top of each bar to the next bar (the waterfall steps). CHANNELS: y position = end (quantitative); x position = service (nominal); x end = next.",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "rule",  // shape / type: rule
        "color": "#8a8378",  // colour #8a8378
        "strokeDash": [3, 3]  // dashed line pattern [dash, gap]
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "end",  // uses the 'end' column
          "type": "quantitative"  // data type: numbers
        },
        "x": {  // x position (left to right)
          "field": "service",  // uses the 'service' column
          "type": "nominal",  // data type: unordered categories (e.g. states)
          "bandPosition": 1  // where in the year's slot to start/end (0.5 = centre)
        },
        "x2": {  // where the shape ends on x
          "field": "next",  // uses the 'next' column
          "bandPosition": 0  // where in the year's slot to start/end (0.5 = centre)
        }
      }
    },
    {  // --- LAYER 3 ---
      "description": "LAYER 3 - '+$168' STYLE LABELS above each bar ('not ticked' if unticked). CHANNELS: y position = end (quantitative); text = lab; opacity changes when datum.ticked.",  // plain-English note about this block (does not change the chart)
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "calculate": "datum.ticked ? '+$' + datum.yearly : 'not ticked'",  // new column calculated with this formula
          "as": "lab"  // name of the new column: lab
        }
      ],
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "dy": -9,  // nudge up (negative) or down (px): -9
        "fontSize": 13,  // text size (px): 13
        "fontWeight": "bold",  // text boldness
        "color": "#8f2d2d"  // colour #8f2d2d
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "end",  // uses the 'end' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "lab"  // uses the 'lab' column
        },
        "opacity": {  // transparency
          "condition": {  // IF the rule below is true, use this value...
            "test": "datum.ticked",  // IF this formula is true
            "value": 1  // ...then use 1
          },
          "value": 0.6  // OTHERWISE use 0.6
        }
      }
    },
    {  // --- LAYER 4 ---
      "description": "LAYER 4 - WHAT EACH APP IS FOR (Ebooks, Audiobooks...) written inside the bar. CHANNELS: y position = end (quantitative); text = covers.",  // plain-English note about this block (does not change the chart)
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "dy": 14,  // nudge up (negative) or down (px): 14
        "fontSize": 12,  // text size (px): 12
        "color": "white",  // colour white
        "baseline": "top"  // vertical text alignment
      },
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "filter": "datum.ticked"  // keep only rows where this is true
        }
      ],
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "end",  // uses the 'end' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "covers"  // uses the 'covers' column
        }
      }
    },
    {  // --- LAYER 5 ---
      "description": "LAYER 5 - THE DARK 'YOU PAY' TOTAL BAR: adds up all ticked apps (aggregate sum) and draws a bar from 0 to the total. CHANNELS: y position = zero (quantitative); y end = total.",  // plain-English note about this block (does not change the chart)
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "aggregate": [  // add up or count rows
            {  // the calculation to do
              "op": "sum",  // operation: sum
              "field": "yearly",  // uses the 'yearly' column
              "as": "total"  // name of the new column: total
            }
          ]
        },
        {  // transform step 2
          "calculate": "'You pay'",  // new column calculated with this formula
          "as": "service"  // name of the new column: service
        },
        {  // transform step 3
          "calculate": "0",  // new column calculated with this formula
          "as": "zero"  // name of the new column: zero
        }
      ],
      "mark": {  // MARK: the shape drawn for each row
        "type": "bar",  // shape / type: bar
        "color": "#2d2a26",  // colour #2d2a26
        "cornerRadius": 2  // rounded corners (px)
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "zero",  // uses the 'zero' column
          "type": "quantitative"  // data type: numbers
        },
        "y2": {  // where the shape ends on y
          "field": "total"  // uses the 'total' column
        },
        "tooltip": [  // what appears in the hover box
          {  // one row in the hover box
            "field": "total",  // uses the 'total' column
            "title": "Total A$ per year"  // title shown: Total A$ per year
          }
        ]
      }
    },
    {  // --- LAYER 6 ---
      "description": "LAYER 6 - THE TOTAL LABEL, e.g. '$785 a year'. CHANNELS: y position = total (quantitative); text = lab.",  // plain-English note about this block (does not change the chart)
      "transform": [  // TRANSFORMS: calculations done on the rows before drawing (run top to bottom)
        {  // transform step 1
          "aggregate": [  // add up or count rows
            {  // the calculation to do
              "op": "sum",  // operation: sum
              "field": "yearly",  // uses the 'yearly' column
              "as": "total"  // name of the new column: total
            }
          ]
        },
        {  // transform step 2
          "calculate": "'You pay'",  // new column calculated with this formula
          "as": "service"  // name of the new column: service
        },
        {  // transform step 3
          "calculate": "'$'+format(datum.total,',')+' a year'",  // new column calculated with this formula
          "as": "lab"  // name of the new column: lab
        }
      ],
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "dy": -9,  // nudge up (negative) or down (px): -9
        "fontSize": 15,  // text size (px): 15
        "fontWeight": "bold",  // text boldness
        "color": "#2d2a26"  // colour #2d2a26
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "total",  // uses the 'total' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "lab"  // uses the 'lab' column
        }
      }
    },
    {  // --- LAYER 7 ---
      "description": "LAYER 7 - TEAL LINE at $0 for the library card. CHANNELS: y position = v (quantitative).",  // plain-English note about this block (does not change the chart)
      "data": {  // DATA: where this chart's rows come from
        "values": [  // rows typed straight into this file
          {"service": "Library card", "v": 0}  // data row 1
        ]
      },
      "mark": {  // MARK: the shape drawn for each row
        "type": "tick",  // shape / type: tick
        "color": "#13827f",  // colour #13827f
        "thickness": 4,  // 'thickness' = 4
        "bandSize": 60  // 'bandSize' = 60
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "v",  // uses the 'v' column
          "type": "quantitative"  // data type: numbers
        }
      }
    },
    {  // --- LAYER 8 ---
      "description": "LAYER 8 - BIG '$0' above the library card line. CHANNELS: y position = v (quantitative); text = t.",  // plain-English note about this block (does not change the chart)
      "data": {  // DATA: where this chart's rows come from
        "values": [  // rows typed straight into this file
          {"service": "Library card", "v": 0, "t": "$0"}  // data row 1
        ]
      },
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "fontWeight": "bold",  // text boldness
        "fontSize": 26,  // text size (px): 26
        "color": "#13827f",  // colour #13827f
        "dy": -26  // nudge up (negative) or down (px): -26
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "v",  // uses the 'v' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "t"  // uses the 't' column
        }
      }
    },
    {  // --- LAYER 9 ---
      "description": "LAYER 9 - 'covers all four' above the $0. CHANNELS: y position = v (quantitative); text = t.",  // plain-English note about this block (does not change the chart)
      "data": {  // DATA: where this chart's rows come from
        "values": [  // rows typed straight into this file
          {"service": "Library card", "v": 0, "t": "covers all four"}  // data row 1
        ]
      },
      "mark": {  // MARK: the shape drawn for each row
        "type": "text",  // shape / type: text
        "fontWeight": "bold",  // text boldness
        "fontSize": 13,  // text size (px): 13
        "color": "#13827f",  // colour #13827f
        "dy": -50  // nudge up (negative) or down (px): -50
      },
      "encoding": {  // ENCODING: which data column controls which visual channel
        "y": {  // y position (up and down)
          "field": "v",  // uses the 'v' column
          "type": "quantitative"  // data type: numbers
        },
        "text": {  // the text shown
          "field": "t"  // uses the 't' column
        }
      }
    }
  ]
}
