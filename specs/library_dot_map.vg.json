{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Every public library branch in Australia",
    "subtitle": "One dot per branch — choose a city to zoom in"
  },
  "width": "container",
  "height": 420,
  "params": [
    {
      "name": "view",
      "value": "All of Australia",
      "bind": {
        "input": "select",
        "name": "View: ",
        "options": [
          "All of Australia",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Hobart",
          "Darwin",
          "Canberra"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "view=='Sydney' ? [151.0,-33.85] : view=='Melbourne' ? [145.0,-37.85] : view=='Brisbane' ? [153.0,-27.5] : view=='Perth' ? [115.9,-31.95] : view=='Adelaide' ? [138.6,-34.92] : view=='Hobart' ? [147.3,-42.88] : view=='Darwin' ? [130.9,-12.45] : view=='Canberra' ? [149.1,-35.3] : [134,-28.5]"
    },
    "scale": {
      "expr": "view=='Sydney' ? 22000 : view=='Melbourne' ? 22000 : view=='Brisbane' ? 22000 : view=='Perth' ? 22000 : view=='Adelaide' ? 22000 : view=='Hobart' ? 30000 : view=='Darwin' ? 30000 : view=='Canberra' ? 30000 : 560"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece7de",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/australian_public_libraries.csv"
      },
      "transform": [
        {
          "filter": "datum.level == 'branch' && datum.longitude > 112"
        }
      ],
      "mark": {
        "type": "circle",
        "size": {
          "expr": "view=='All of Australia' ? 12 : 60"
        },
        "opacity": 0.65,
        "color": "#b5532d",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Library"
          },
          {
            "field": "suburb",
            "title": "Suburb"
          },
          {
            "field": "state",
            "title": "State"
          }
        ]
      }
    }
  ]
}