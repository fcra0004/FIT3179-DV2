{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Story time draws the biggest crowds",
    "subtitle": "Program attendances per 1,000 residents, 2024-25"
  },
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/programs_by_audience_2024_25.csv",
    "format": {
      "parse": {
        "participants": "number",
        "population_millions": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.participants / (datum.population_millions*1000)",
      "as": "per_1000"
    }
  ],
  "encoding": {
    "x": {
      "field": "audience",
      "type": "nominal",
      "title": null,
      "sort": [
        "Early childhood",
        "Children",
        "Young adult",
        "Adults",
        "Seniors",
        "All ages"
      ],
      "axis": {
        "labelAngle": 0,
        "orient": "top"
      }
    },
    "y": {
      "field": "abbr",
      "type": "nominal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "per_1000",
          "type": "quantitative",
          "title": "Per 1,000 people",
          "scale": {
            "scheme": "orangered"
          }
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "audience"
          },
          {
            "field": "participants",
            "format": ","
          },
          {
            "field": "per_1000",
            "title": "Per 1,000 people",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "per_1000",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.per_1000 > 90",
            "value": "white"
          },
          "value": "#3b3a36"
        }
      }
    }
  ]
}